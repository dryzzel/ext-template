{
  "name": "espocrm-ext-espo-notes",
  "version": "1.1.0",
  "description": "Agent notes and callbacks for EspoCRM 9.3.3",
  "scripts": {
    "sa": "vendor/bin/phpstan",
    "copy": "node build --copy",
    "composer-install": "node build --composer-install",
    "sync": "node build --copy && node build --composer-install",
    "extension": "node build --extension",
    "clear-cache": "php site/clear_cache.php",
    "rebuild": "node build --rebuild",
    "all": "node build --all",
    "prepare-test": "node build --prepare-test",
    "test": "npm run test:integration && npm run test:browser && npm run test:lifecycle",
    "dev:setup": "node tests/runtime/setup.mjs",
    "dev:stop": "docker compose -f compose.dev.yaml --profile websocket down",
    "test:lifecycle": "node tests/runtime/lifecycle.mjs",
    "test:integration": "node tests/runtime/api.mjs",
    "test:browser": "node tests/runtime/browser.mjs",
    "test:lint": "node tests/runtime/lint.mjs"
  },
  "type": "module",
  "author": "DOV",
  "dependencies": {
    "espo-extension-tools": "github:espocrm/extension-tools#0.4.5",
    "fs-extra": "^9.0.0"
  },
  "engines": {
    "npm": ">=8",
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0"
  }
}
