{
    "fields": {
        "name": {"type": "varchar", "readOnly": true, "maxLength": 255},
        "description": {"type": "text", "required": true, "preview": true},
        "customerName": {"type": "varchar", "maxLength": 255},
        "phoneNumber": {"type": "varchar", "maxLength": 100},
        "isCallback": {"type": "bool", "default": false},
        "dateStart": {"type": "datetime", "audited": true},
        "reminderMinutes": {"type": "enumInt", "options": [-1, 0, 5, 15, 60], "default": 0},
        "reminders": {"type": "jsonArray", "notStorable": true, "utility": true, "readOnly": true},
        "status": {"type": "enum", "options": ["Open", "Completed", "Archived"], "default": "Open", "audited": true, "displayAsLabel": true, "style": {"Completed": "success", "Archived": "info"}},
        "parent": {"type": "linkParent", "entityList": ["Account", "Contact", "Lead", "Opportunity", "Case"]},
        "assignedUser": {"type": "link", "readOnly": true, "view": "views/fields/assigned-user"},
        "teams": {"type": "linkMultiple", "readOnly": true, "view": "views/fields/teams"},
        "createdAt": {"type": "datetime", "readOnly": true},
        "modifiedAt": {"type": "datetime", "readOnly": true},
        "createdBy": {"type": "link", "readOnly": true},
        "modifiedBy": {"type": "link", "readOnly": true}
    },
    "links": {
        "parent": {"type": "belongsToParent"},
        "assignedUser": {"type": "belongsTo", "entity": "User"},
        "teams": {"type": "hasMany", "entity": "Team", "relationName": "entityTeam", "layoutRelationshipsDisabled": true},
        "createdBy": {"type": "belongsTo", "entity": "User"},
        "modifiedBy": {"type": "belongsTo", "entity": "User"}
    },
    "collection": {"orderBy": "modifiedAt", "order": "desc", "textFilterFields": ["name", "description", "customerName", "phoneNumber"]},
    "indexes": {
        "ownerStatusDate": {"columns": ["assignedUserId", "status", "dateStart", "deleted"]},
        "statusDate": {"columns": ["status", "dateStart", "deleted"]}
    },
    "repositoryClassName": "Espo\\Core\\Repositories\\Event",
    "optimisticConcurrencyControl": true
}
